/* ===== Murthu Desktop Theme : aurora + glass + glow ===== */
body.mt-desk {
  background: #05060f !important;
  overflow-x: hidden;
}
body.mt-desk::before {
  content: "";
  position: fixed; inset: -20%;
  z-index: 0; pointer-events: none;
  background:
    radial-gradient(40% 40% at 20% 25%, rgba(0, 140, 255, .55), transparent 70%),
    radial-gradient(35% 35% at 80% 20%, rgba(170, 60, 255, .50), transparent 70%),
    radial-gradient(40% 40% at 70% 80%, rgba(0, 230, 190, .40), transparent 70%),
    radial-gradient(35% 35% at 15% 85%, rgba(255, 60, 150, .38), transparent 70%);
  filter: blur(40px);
  animation: mt-aurora 18s ease-in-out infinite alternate;
}
@keyframes mt-aurora {
  0%   { transform: translate3d(0,0,0) rotate(0deg) scale(1); }
  50%  { transform: translate3d(3%,-4%,0) rotate(8deg) scale(1.12); }
  100% { transform: translate3d(-4%,3%,0) rotate(-6deg) scale(1.05); }
}
body.mt-desk .main-section,
body.mt-desk .layout-main-section,
body.mt-desk .page-container,
body.mt-desk #body,
body.mt-desk .desktop-container,
body.mt-desk [class*="desktop"] { background: transparent !important; }

/* navbar glass */
body.mt-desk .navbar {
  background: rgba(10, 14, 30, .55) !important;
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255,255,255,.08) !important;
}
body.mt-desk .navbar .form-control,
body.mt-desk .navbar input {
  background: rgba(255,255,255,.08) !important;
  color: #fff !important;
  border: 1px solid rgba(255,255,255,.12) !important;
}

/* ---- Icons ---- */
body.mt-desk .desktop-icon,
body.mt-desk [class*="desktop-icon"] {
  transition: transform .35s cubic-bezier(.2,.9,.3,1.4), filter .35s;
  animation: mt-float 5s ease-in-out infinite;
  cursor: pointer;
}
body.mt-desk .desktop-icon:nth-child(2n)  { animation-delay: -1.2s; }
body.mt-desk .desktop-icon:nth-child(3n)  { animation-delay: -2.4s; }
body.mt-desk .desktop-icon:nth-child(5n)  { animation-delay: -3.6s; }
@keyframes mt-float {
  0%,100% { transform: translateY(0); }
  50%     { transform: translateY(-9px); }
}
body.mt-desk .desktop-icon:hover {
  animation-play-state: paused;
  transform: translateY(-14px) scale(1.18) rotate(-2deg);
  filter: drop-shadow(0 0 22px rgba(0,190,255,.9));
  z-index: 5;
}
body.mt-desk .desktop-icon:active { transform: scale(.94); }

body.mt-desk .desktop-icon .icon-container,
body.mt-desk .desktop-icon [class*="icon-container"],
body.mt-desk .desktop-icon > div:first-child {
  border-radius: 22px !important;
  background: linear-gradient(145deg, rgba(255,255,255,.22), rgba(255,255,255,.04)) !important;
  border: 1px solid rgba(255,255,255,.28);
  box-shadow: 0 8px 30px rgba(0,0,0,.45),
              0 0 22px rgba(0,160,255,.45),
              inset 0 1px 0 rgba(255,255,255,.45);
  backdrop-filter: blur(10px);
  position: relative; overflow: hidden;
}
/* shine sweep */
body.mt-desk .desktop-icon .icon-container::after,
body.mt-desk .desktop-icon > div:first-child::after {
  content: ""; position: absolute; top: -50%; left: -60%;
  width: 40%; height: 200%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent);
  transform: rotate(25deg);
  animation: mt-shine 4.5s ease-in-out infinite;
}
@keyframes mt-shine {
  0%, 60% { left: -60%; }
  100%    { left: 140%; }
}

/* labels */
body.mt-desk .desktop-icon .icon-title,
body.mt-desk .desktop-icon [class*="title"],
body.mt-desk .desktop-icon span {
  color: #fff !important;
  font-weight: 600;
  letter-spacing: .3px;
  text-shadow: 0 2px 12px rgba(0,0,0,.8), 0 0 14px rgba(0,180,255,.6);
}

/* ---- FX canvas ---- */
#mt-fx {
  position: fixed; inset: 0; z-index: 3;
  pointer-events: none; display: none;
  mix-blend-mode: screen;
}
body.mt-desk #mt-fx { display: block; }

/* welcome banner */
#mt-welcome {
  position: fixed; top: 90px; left: 50%;
  transform: translate(-50%, -30px) scale(.9);
  z-index: 9; opacity: 0; pointer-events: none;
  padding: 14px 34px; border-radius: 50px;
  font-size: 22px; font-weight: 700; color: #fff;
  background: linear-gradient(90deg, #00c6ff, #7a5cff, #ff4fa3);
  box-shadow: 0 0 40px rgba(122,92,255,.8);
  transition: all .7s cubic-bezier(.2,.9,.3,1.4);
}
#mt-welcome.show { opacity: 1; transform: translate(-50%, 0) scale(1); }

@media (prefers-reduced-motion: reduce) {
  body.mt-desk::before, body.mt-desk .desktop-icon,
  body.mt-desk .desktop-icon .icon-container::after { animation: none !important; }
}

/* ===== Readability fix: dark glass panel + light text on content pages ===== */
html:has(body.mt-desk) { background: #05060f !important; }

body.mt-desk .layout-main-section,
body.mt-desk .page-content,
body.mt-desk .form-layout,
body.mt-desk .frappe-card,
body.mt-desk .layout-main-section-wrapper {
  background: rgba(10, 14, 34, .62) !important;
  backdrop-filter: blur(18px) saturate(140%);
  -webkit-backdrop-filter: blur(18px) saturate(140%);
  border: 1px solid rgba(255, 255, 255, .12) !important;
  border-radius: 20px !important;
  box-shadow: 0 12px 40px rgba(0, 0, 0, .45), 0 0 40px rgba(122, 92, 255, .18);
}

/* all text on content pages: bright */
body.mt-desk .layout-main-section,
body.mt-desk .layout-main-section *,
body.mt-desk .page-content,
body.mt-desk .page-content *,
body.mt-desk .form-layout .control-label,
body.mt-desk .form-layout .section-head,
body.mt-desk .form-layout .help-box,
body.mt-desk .list-row,
body.mt-desk .list-row .level-item,
body.mt-desk .list-row-head,
body.mt-desk .page-title .title-text,
body.mt-desk .layout-side-section a,
body.mt-desk .sidebar-section a,
body.mt-desk .ql-editor,
body.mt-desk .ql-editor * {
  color: rgba(255, 255, 255, .94) !important;
}

/* headings with a soft glow */
body.mt-desk h1, body.mt-desk h2, body.mt-desk h3, body.mt-desk h4 {
  color: #fff !important;
  text-shadow: 0 0 18px rgba(0, 190, 255, .45);
}

/* links */
body.mt-desk .layout-main-section a,
body.mt-desk .page-content a {
  color: #7fd8ff !important;
}

/* list rows */
body.mt-desk .list-row-container,
body.mt-desk .result,
body.mt-desk .list-row-head {
  background: rgba(255, 255, 255, .06) !important;
  border-color: rgba(255, 255, 255, .10) !important;
}
body.mt-desk .list-row-container:hover {
  background: rgba(255, 255, 255, .14) !important;
}

/* inputs: dark glass with light text */
body.mt-desk .form-control,
body.mt-desk .control-input input,
body.mt-desk .control-input select,
body.mt-desk .control-input textarea {
  background: rgba(255, 255, 255, .10) !important;
  color: #fff !important;
  border: 1px solid rgba(255, 255, 255, .18) !important;
}
body.mt-desk .form-control::placeholder { color: rgba(255, 255, 255, .45) !important; }

/* tables (Pipeline Steps etc.): header and cells readable */
body.mt-desk table th {
  background: rgba(255, 255, 255, .14) !important;
  color: #fff !important;
}
body.mt-desk table td {
  color: rgba(255, 255, 255, .92) !important;
  border-color: rgba(255, 255, 255, .12) !important;
}

/* stars: keep them, but softer so text stays clear */
#mt-fx { opacity: .45; }

/* ===== v3: variable-based readability fix (works on every desk page) ===== */
body.mt-desk .page-container {
  --text-color: #f2f4ff;
  --heading-color: #ffffff;
  --text-muted: #c3c9ea;
  --text-light: #b4bbdf;
  --text-dark: #ffffff;
  --control-bg: rgba(255, 255, 255, .10);
  --control-bg-on-gray: rgba(255, 255, 255, .10);
  --border-color: rgba(255, 255, 255, .14);
  --card-bg: rgba(10, 14, 34, .60);
  --fg-color: rgba(10, 14, 34, .60);
  color: #f2f4ff;
}

/* keep the white top bar readable (dark text on light bar) */
body.mt-desk .page-container .page-head,
body.mt-desk .page-container .page-head * {
  --text-color: #1b1f3b;
  --heading-color: #1b1f3b;
  --text-muted: #6b7280;
}

/* fallback: force bright text on content, except top bar and light table headers */
body.mt-desk .page-container *:not(.page-head):not(.page-head *):not(th):not(th *):not(svg):not(svg *):not(.btn):not(.btn *) {
  color: #f2f4ff !important;
}
body.mt-desk .page-container h1,
body.mt-desk .page-container h2,
body.mt-desk .page-container h3,
body.mt-desk .page-container h4 {
  color: #ffffff !important;
  text-shadow: 0 0 18px rgba(0, 190, 255, .45);
}
body.mt-desk .page-container a:not(.btn) { color: #7fd8ff !important; }

/* light table header keeps dark text so it stays readable */
body.mt-desk .page-container th { color: #1b1f3b !important; }

/* stars softer so they never hide text */
#mt-fx { opacity: .35; }

/* ===== v5a: doctype/list/form readability (non-desktop pages) ===== */
body:not(.mt-desk) #mt-fx { display: none !important; }

body:not(.mt-desk) .page-container,
body:not(.mt-desk) .layout-main-section,
body:not(.mt-desk) .layout-main-section-wrapper,
body:not(.mt-desk) .form-layout,
body:not(.mt-desk) .frappe-card,
body:not(.mt-desk) .page-content {
  background: #ffffff !important;
  color: #1b1f3b !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
}

body:not(.mt-desk) {
  --text-color: #1b1f3b;
  --heading-color: #111430;
  --text-muted: #5b6280;
  --text-light: #6b7280;
  --border-color: #d5daea;
  --control-bg: #f1f3fa;
  --card-bg: #ffffff;
  --fg-color: #ffffff;
}

body:not(.mt-desk) .control-label,
body:not(.mt-desk) .section-head,
body:not(.mt-desk) .list-row,
body:not(.mt-desk) .list-row .level-item,
body:not(.mt-desk) .list-row a,
body:not(.mt-desk) .page-title .title-text,
body:not(.mt-desk) .sidebar-section a,
body:not(.mt-desk) .layout-side-section a,
body:not(.mt-desk) .like-disabled-input,
body:not(.mt-desk) .control-value {
  color: #1b1f3b !important;
}

/* ===== v5b: inputs, tables, links ===== */
body:not(.mt-desk) .form-control,
body:not(.mt-desk) .input-with-feedback,
body:not(.mt-desk) .ql-editor {
  background: #f1f3fa !important;
  color: #1b1f3b !important;
  border: 1px solid #c9cfe3 !important;
}
body:not(.mt-desk) .form-control:focus {
  background: #ffffff !important;
  border-color: #6a5cff !important;
  box-shadow: 0 0 0 3px rgba(106, 92, 255, .18) !important;
}
body:not(.mt-desk) .form-control::placeholder { color: #8a91ad !important; }

body:not(.mt-desk) .list-row-head,
body:not(.mt-desk) .grid-heading-row {
  background: #eef0f9 !important;
  color: #1b1f3b !important;
}
body:not(.mt-desk) .list-row { border-bottom: 1px solid #e3e6f2 !important; }
body:not(.mt-desk) .list-row:hover,
body:not(.mt-desk) .grid-row:hover { background: #f6f7fd !important; }
body:not(.mt-desk) .grid-static-col,
body:not(.mt-desk) .grid-body .static-area { color: #1b1f3b !important; }

body:not(.mt-desk) .page-container a:not(.btn) { color: #4338ca !important; }
